# OpenRouter API keys (rotate across accounts for higher quota)
OpenRouter=sk-or-v1-your-key-here
OpenRouter2=sk-or-v1-second-key
OpenRouter3=sk-or-v1-third-key
OpenRouter4=sk-or-v1-fourth-key

# Google AI Studio (free at aistudio.google.com)
# Create 2 keys for rotation: Key1 (86 RPD) exhausts first, then Key2 (1,500 RPD)
GOOGLE_AI_API_KEY=AIza-your-first-key
GOOGLE_AI_API_KEY2=AIza-your-second-key

# Telegram notifications (create a bot via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

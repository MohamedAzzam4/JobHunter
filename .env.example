# OpenRouter API keys — create multiple free accounts at openrouter.ai
# Using keys from different accounts increases your daily quota
OpenRouter=sk-or-v1-your-key-here
OpenRouter2=sk-or-v1-second-key
OpenRouter3=sk-or-v1-third-key
OpenRouter4=sk-or-v1-fourth-key

# Google AI Studio — create free keys at aistudio.google.com
# Use keys from different Google accounts to increase your daily limit
# The system rotates to the next key automatically when one hits its rate limit
GOOGLE_AI_API_KEY=AIza-your-first-key
GOOGLE_AI_API_KEY2=AIza-your-second-key

# Telegram notifications (create a bot via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
